{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aios-seo.invalid/v1/model-result.schema.json",
  "type": "object",
  "properties": {
    "request_id": {
      "$ref": "https://schemas.aios-seo.invalid/v1/common.schema.json#/$defs/id"
    },
    "status": {
      "enum": [
        "validated",
        "invalid",
        "unavailable",
        "timeout"
      ]
    },
    "provider": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "model_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "adapter_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "response_hash": {
      "anyOf": [
        {
          "$ref": "https://schemas.aios-seo.invalid/v1/common.schema.json#/$defs/hash"
        },
        {
          "type": "null"
        }
      ]
    },
    "output": {
      "anyOf": [
        {
          "$ref": "https://schemas.aios-seo.invalid/v1/inference-output.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "input_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "output_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "cost_microusd": {
      "type": "integer",
      "minimum": 0
    },
    "validation_errors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "minItems": 0,
      "maxItems": 5000,
      "uniqueItems": true
    }
  },
  "required": [
    "request_id",
    "status",
    "provider",
    "model_version",
    "adapter_version",
    "response_hash",
    "output",
    "input_tokens",
    "output_tokens",
    "cost_microusd",
    "validation_errors"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "validated"
          }
        }
      },
      "then": {
        "properties": {
          "output": {
            "$ref": "https://schemas.aios-seo.invalid/v1/inference-output.schema.json"
          },
          "response_hash": {
            "$ref": "https://schemas.aios-seo.invalid/v1/common.schema.json#/$defs/hash"
          },
          "validation_errors": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "output": {
            "type": "null"
          }
        }
      }
    }
  ]
}
