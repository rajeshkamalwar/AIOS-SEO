{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aios-seo.invalid/v1/http-seed-execution.schema.json",
  "description": "Local governed submitted-seed one-hop operational receipt. Not Evidence acceptance, target/job completion or public collection authority.",
  "type": "object",
  "properties": {
    "state": {
      "enum": [
        "completed",
        "failed",
        "aborted",
        "timeout"
      ]
    },
    "reservation": {
      "type": "object",
      "properties": {
        "reservationId": {
          "$ref": "https://schemas.aios-seo.invalid/v1/common.schema.json#/$defs/id"
        },
        "invocationId": {
          "$ref": "https://schemas.aios-seo.invalid/v1/common.schema.json#/$defs/id"
        },
        "origin": {
          "type": "string",
          "format": "uri",
          "maxLength": 256
        },
        "maxDecodedBytes": {
          "const": 5242880
        },
        "startedAt": {
          "$ref": "https://schemas.aios-seo.invalid/v1/common.schema.json#/$defs/time"
        },
        "state": {
          "const": "settled"
        }
      },
      "required": [
        "reservationId",
        "invocationId",
        "origin",
        "maxDecodedBytes",
        "startedAt",
        "state"
      ],
      "additionalProperties": false
    },
    "terminalReceiptId": {
      "$ref": "https://schemas.aios-seo.invalid/v1/common.schema.json#/$defs/id"
    },
    "containerId": {
      "$ref": "https://schemas.aios-seo.invalid/v1/common.schema.json#/$defs/hash"
    },
    "result": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "integer",
              "minimum": 100,
              "maximum": 599
            },
            "truncated": {
              "type": "boolean"
            },
            "retainedBodyBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5242880
            },
            "retainedBodySha256": {
              "anyOf": [
                {
                  "$ref": "https://schemas.aios-seo.invalid/v1/common.schema.json#/$defs/hash"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "status",
            "truncated",
            "retainedBodyBytes",
            "retainedBodySha256"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "retainedBodySha256": {
                    "type": "null"
                  }
                }
              },
              "then": {
                "properties": {
                  "retainedBodyBytes": {
                    "const": 0
                  }
                }
              }
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "evidenceAccepted": {
      "const": false
    }
  },
  "required": [
    "state",
    "reservation",
    "terminalReceiptId",
    "containerId",
    "result",
    "evidenceAccepted"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "completed"
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "type": "object",
            "properties": {
              "status": {
                "type": "integer",
                "minimum": 100,
                "maximum": 599
              },
              "truncated": {
                "type": "boolean"
              },
              "retainedBodyBytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 5242880
              },
              "retainedBodySha256": {
                "anyOf": [
                  {
                    "$ref": "https://schemas.aios-seo.invalid/v1/common.schema.json#/$defs/hash"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "status",
              "truncated",
              "retainedBodyBytes",
              "retainedBodySha256"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "retainedBodySha256": {
                      "type": "null"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "retainedBodyBytes": {
                      "const": 0
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "else": {
        "properties": {
          "result": {
            "type": "null"
          }
        }
      }
    }
  ]
}
