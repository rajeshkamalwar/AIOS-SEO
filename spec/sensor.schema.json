{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aios-seo.invalid/v1/sensor.schema.json",
  "type": "object",
  "properties": {
    "sensor_id": {
      "enum": [
        "http",
        "html",
        "robots",
        "sitemap",
        "browser_render",
        "public_assets",
        "gsc",
        "analytics",
        "bing"
      ]
    },
    "version": {
      "$ref": "https://schemas.aios-seo.invalid/v1/common.schema.json#/$defs/version"
    },
    "class": {
      "enum": [
        "public",
        "connected"
      ]
    },
    "tenant_id": {
      "$ref": "https://schemas.aios-seo.invalid/v1/common.schema.json#/$defs/id"
    },
    "site_id": {
      "$ref": "https://schemas.aios-seo.invalid/v1/common.schema.json#/$defs/id"
    },
    "connector_id": {
      "anyOf": [
        {
          "$ref": "https://schemas.aios-seo.invalid/v1/common.schema.json#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "collection_id": {
      "$ref": "https://schemas.aios-seo.invalid/v1/common.schema.json#/$defs/id"
    },
    "collected_at": {
      "$ref": "https://schemas.aios-seo.invalid/v1/common.schema.json#/$defs/time"
    },
    "window_start": {
      "anyOf": [
        {
          "$ref": "https://schemas.aios-seo.invalid/v1/common.schema.json#/$defs/time"
        },
        {
          "type": "null"
        }
      ]
    },
    "window_end": {
      "anyOf": [
        {
          "$ref": "https://schemas.aios-seo.invalid/v1/common.schema.json#/$defs/time"
        },
        {
          "type": "null"
        }
      ]
    },
    "fresh_until": {
      "$ref": "https://schemas.aios-seo.invalid/v1/common.schema.json#/$defs/time"
    },
    "scope_urls": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "minItems": 0,
      "maxItems": 5000,
      "uniqueItems": true
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "minItems": 0,
      "maxItems": 5000,
      "uniqueItems": true
    },
    "coverage": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "complete_in_scope",
            "partial",
            "unknown",
            "not_applicable"
          ]
        },
        "requested": {
          "type": "integer",
          "minimum": 0
        },
        "observed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "excluded": {
          "type": "integer",
          "minimum": 0
        },
        "deferred": {
          "type": "integer",
          "minimum": 0
        },
        "denominator": {
          "enum": [
            "requested_scope",
            "unknown_population"
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "requested",
        "observed",
        "failed",
        "excluded",
        "deferred",
        "denominator",
        "reason"
      ],
      "additionalProperties": false
    },
    "sampling": {
      "enum": [
        "all_admitted",
        "template_sample",
        "not_collected"
      ]
    },
    "observation_ids": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.aios-seo.invalid/v1/common.schema.json#/$defs/id"
      },
      "minItems": 0,
      "maxItems": 5000,
      "uniqueItems": true
    },
    "missingness": {
      "anyOf": [
        {
          "$ref": "https://schemas.aios-seo.invalid/v1/common.schema.json#/$defs/unknown"
        },
        {
          "type": "null"
        }
      ]
    },
    "retry": {
      "type": "object",
      "properties": {
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "max_attempts": {
          "const": 3
        },
        "retry_at": {
          "anyOf": [
            {
              "$ref": "https://schemas.aios-seo.invalid/v1/common.schema.json#/$defs/time"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "attempt",
        "max_attempts",
        "retry_at"
      ],
      "additionalProperties": false
    },
    "cost_microusd": {
      "type": "integer",
      "minimum": 0
    },
    "health": {
      "enum": [
        "healthy",
        "degraded",
        "unknown",
        "disabled"
      ]
    },
    "error": {
      "anyOf": [
        {
          "$ref": "https://schemas.aios-seo.invalid/v1/common.schema.json#/$defs/error"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "sensor_id",
    "version",
    "class",
    "tenant_id",
    "site_id",
    "connector_id",
    "collection_id",
    "collected_at",
    "window_start",
    "window_end",
    "fresh_until",
    "scope_urls",
    "permissions",
    "coverage",
    "sampling",
    "observation_ids",
    "missingness",
    "retry",
    "cost_microusd",
    "health",
    "error"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "missingness": {
            "type": "object",
            "properties": {
              "reason": {
                "const": "not_connected"
              }
            },
            "required": [
              "reason"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "observation_ids": {
            "maxItems": 0
          },
          "coverage": {
            "properties": {
              "status": {
                "const": "unknown"
              }
            }
          },
          "health": {
            "const": "unknown"
          }
        }
      }
    }
  ]
}
