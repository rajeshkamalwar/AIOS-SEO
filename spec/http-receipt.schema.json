{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aios-seo.invalid/v1/http-receipt.schema.json",
  "type": "object",
  "properties": {
    "url": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "method": {
      "enum": [
        "GET",
        "HEAD"
      ]
    },
    "status_code": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        {
          "type": "null"
        }
      ]
    },
    "headers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "required": [
          "name",
          "value"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 5000,
      "uniqueItems": true
    },
    "body_evidence_id": {
      "anyOf": [
        {
          "$ref": "https://schemas.aios-seo.invalid/v1/common.schema.json#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "final_url": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "truncated": {
      "type": "boolean"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "https://schemas.aios-seo.invalid/v1/common.schema.json#/$defs/error"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "url",
    "method",
    "status_code",
    "headers",
    "body_evidence_id",
    "final_url",
    "truncated",
    "error"
  ],
  "additionalProperties": false
}
